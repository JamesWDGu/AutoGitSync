# docker compose reads a .env file next to it automatically (optional: exporting the
# variables in your shell works just as well).
#
# Only these two are read from here; every other switch lives in docker-compose.yml.

# required: the Git repository to sync into
GIT_REPO=https://github.com/your-name/my-configs.git

# needed for private repositories (leave empty for public ones)
GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
