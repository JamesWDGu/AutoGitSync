# docker compose 会自动读取同目录下的 .env（可选：也可以直接在 shell 里 export）
# 这些变量只用于 docker-compose.yml 的 ${...} 替换，服务本身读的就是环境变量

# 必填：Git 仓库地址
AGS_GIT_REPO=https://github.com/your-name/my-configs.git

# 私有仓库需要（公开仓库可留空）
AGS_GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：只同步匹配该正则的文件
# AGS_INCLUDE=\.(conf|ya?ml)$
